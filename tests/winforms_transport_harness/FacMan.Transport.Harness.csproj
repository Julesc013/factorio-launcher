    <Compile Include="..\..\apps\gui\windows\winforms\CommandCatalog.cs" Link="CommandCatalog.cs" />
    <Compile Include="..\..\apps\gui\windows\winforms\TransportOptions.cs" Link="TransportOptions.cs" />
    <Compile Include="..\..\apps\gui\windows\winforms\BoundedByteChannel.cs" Link="BoundedByteChannel.cs" />
    <Compile Include="..\..\apps\gui\windows\winforms\StrictTransportJson.cs" Link="StrictTransportJson.cs" />
    <Compile Include="..\..\apps\gui\windows\winforms\TransportResponseDecoder.cs" Link="TransportResponseDecoder.cs" />
    <Compile Include="..\..\apps\gui\windows\winforms\WindowsContainedProcess.cs" Link="WindowsContainedProcess.cs" />
    <Compile Include="..\..\apps\gui\windows\winforms\CliProcessClient.cs" Link="CliProcessClient.cs" />
    <Compile Include="TransportHarness.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
