{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.invalid/schema/factorio/factorio_managed_repair_review.v1.schema.json",
  "title": "Explicit managed repair review retained by semantic action receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "archive_source_identity",
    "owner_plan",
    "workspace_id",
    "workspace_root_digest"
  ],
  "properties": {
    "schema": {
      "const": "factorio.managed_repair_review.v1"
    },
    "archive_source_identity": {
      "type": "string",
      "pattern": "^file:.+:sha256:[0-9a-f]{64}$"
    },
    "owner_plan": {
      "$ref": "https://julesc013.github.io/factorio-launcher/contracts/schema/factorio/factorio_managed_repair_plan.v1.schema.json"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
