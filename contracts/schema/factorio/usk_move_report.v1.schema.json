{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.invalid/schema/factorio/usk_move_report.v1.schema.json",
  "title": "Pinned provider move report: reference updates and old removal deferred",
  "type": "object",
  "properties": {
    "completed_at": {
      "type": "string",
      "minLength": 1
    },
    "install_id": {
      "type": "string",
      "minLength": 1
    },
    "new_root": {
      "type": "string",
      "minLength": 1
    },
    "old_root": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "usk.move_report.v1"
    },
    "status": {
      "const": "new_committed_old_retained"
    },
    "old_root_status": {
      "const": "retired_retained"
    },
    "reference_update_status": {
      "const": "not_started"
    },
    "report_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "new_verification_ref": {
      "type": "object",
      "properties": {
        "report_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "warn"
          ]
        }
      },
      "required": [
        "report_digest",
        "report_id",
        "status"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "phase": {
              "const": "copy_to_staging"
            },
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "phase",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "const": "verify_closure"
            },
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "phase",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "const": "commit_new"
            },
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "phase",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "const": "update_references"
            },
            "status": {
              "const": "deferred"
            }
          },
          "required": [
            "phase",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "const": "retire_old"
            },
            "status": {
              "const": "completed"
            }
          },
          "required": [
            "phase",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "const": "accept_old_removal"
            },
            "status": {
              "const": "deferred"
            }
          },
          "required": [
            "phase",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "const": "remove_old_owned_state"
            },
            "status": {
              "const": "deferred"
            }
          },
          "required": [
            "phase",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "completed_at",
    "install_id",
    "new_root",
    "old_root",
    "plan_id",
    "report_id",
    "transaction_id",
    "schema",
    "status",
    "old_root_status",
    "reference_update_status",
    "report_digest",
    "new_verification_ref",
    "phases"
  ],
  "additionalProperties": false
}
