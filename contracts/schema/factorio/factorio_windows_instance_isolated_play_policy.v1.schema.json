{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factorio.windows_instance_isolated_play_policy.v1.schema.json",
  "title": "Frozen Windows normal-host instance-isolated Factorio Play policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "policy_revision",
    "canonicalization_version",
    "policy_digest",
    "status",
    "human_journey",
    "automated_negative_controls",
    "explicit_exclusions",
    "source_evidence",
    "claim",
    "candidate",
    "provider_baseline",
    "launch",
    "evidence_inventory",
    "writable_resources",
    "protected_resources",
    "effect_dispositions",
    "external_effect_disclosures",
    "evidence_requirements",
    "observation_scopes",
    "verdict_criteria",
    "required_validation",
    "governance",
    "authority_boundary"
  ],
  "properties": {
    "schema": {"const": "factorio.windows_instance_isolated_play_policy.v1"},
    "policy_id": {"const": "facman.windows-instance-isolated-play.2.0.77.x64.v1"},
    "policy_revision": {"const": "1"},
    "canonicalization_version": {"const": "facman.sorted-json.v1"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "frozen_criteria_no_result"},
    "human_journey": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "automated_negative_controls": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "explicit_exclusions": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "source_evidence": {"type": "object"},
    "claim": {"type": "object"},
    "candidate": {"type": "object"},
    "provider_baseline": {"type": "object"},
    "launch": {"type": "object"},
    "evidence_inventory": {"type": "array", "minItems": 8, "items": {"type": "object"}},
    "writable_resources": {"type": "array", "minItems": 7, "items": {"type": "object"}},
    "protected_resources": {"type": "array", "minItems": 12, "items": {"type": "object"}},
    "effect_dispositions": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object"}},
    "external_effect_disclosures": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "evidence_requirements": {
      "type": "array",
      "minItems": 25,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "observation_scopes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "verdict_criteria": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object"}},
    "required_validation": {"type": "object"},
    "governance": {"type": "object"},
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_command",
        "permit_issuer",
        "permit_issuance_authority",
        "process_execution",
        "real_factorio_execution",
        "product_apply_route",
        "setup_authority",
        "credential_authority",
        "network_authority",
        "host_mutation_authority",
        "signing",
        "publication",
        "safe_beta"
      ],
      "properties": {
        "public_command": {"const": false},
        "permit_issuer": {"const": false},
        "permit_issuance_authority": {"const": false},
        "process_execution": {"const": false},
        "real_factorio_execution": {"const": false},
        "product_apply_route": {"const": false},
        "setup_authority": {"const": false},
        "credential_authority": {"const": false},
        "network_authority": {"const": false},
        "host_mutation_authority": {"const": false},
        "signing": {"const": false},
        "publication": {"const": false},
        "safe_beta": {"const": false}
      }
    }
  }
}
