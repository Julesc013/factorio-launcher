{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.invalid/schema/factorio/factorio_configuration_preparation_plan.v1.schema.json",
  "title": "Routing configuration preparation plan",
  "type": "object",
  "required": [
    "schema",
    "instance_id",
    "launch_intent",
    "component",
    "composition",
    "inputs_sha256",
    "parent_before_identity",
    "target",
    "preparation_available",
    "mutation_executed",
    "execution_started",
    "permit_issued",
    "factorio_support_claim",
    "plan_sha256",
    "instance_root",
    "config_text",
    "config_sha256",
    "existing_settings_modified"
  ],
  "properties": {
    "schema": {
      "const": "factorio.configuration_preparation_plan.v1"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "launch_intent": {
      "enum": [
        "menu",
        "load_save"
      ]
    },
    "component": {
      "enum": [
        "missing_routing_configuration",
        "existing_routing_configuration"
      ]
    },
    "composition": {
      "const": "partial"
    },
    "inputs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_before_identity": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "preparation_available": {
      "const": true
    },
    "mutation_executed": {
      "const": false
    },
    "execution_started": {
      "const": false
    },
    "permit_issued": {
      "const": false
    },
    "factorio_support_claim": {
      "const": "unclaimed"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instance_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "config_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "existing_settings_modified": {
      "const": false
    },
    "original_config_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "original_config_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_metadata_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 196608
    },
    "original_device": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "original_object": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "original_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "component": {
            "const": "existing_routing_configuration"
          }
        }
      },
      "then": {
        "required": [
          "original_config_text",
          "original_config_sha256",
          "original_metadata_identity",
          "original_device",
          "original_object",
          "original_size"
        ]
      }
    }
  ]
}
