{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.invalid/schema/factorio/factorio_configuration_preparation_result.v1.schema.json",
  "title": "Missing routing configuration preparation result",
  "type": "object",
  "required": [
    "schema",
    "command",
    "status",
    "instance_id",
    "transaction_id",
    "target",
    "composition",
    "mutation_executed",
    "existing_settings_modified",
    "execution_started",
    "permit_issued",
    "factorio_support_claim"
  ],
  "properties": {
    "schema": {
      "const": "factorio.configuration_preparation_result.v1"
    },
    "command": {
      "const": "readiness.prepare_configuration"
    },
    "status": {
      "const": "routing_configuration_created"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "composition": {
      "const": "partial"
    },
    "mutation_executed": {
      "const": true
    },
    "execution_started": {
      "const": false
    },
    "permit_issued": {
      "const": false
    },
    "factorio_support_claim": {
      "const": "unclaimed"
    },
    "existing_settings_modified": {
      "const": false
    }
  },
  "additionalProperties": false
}
