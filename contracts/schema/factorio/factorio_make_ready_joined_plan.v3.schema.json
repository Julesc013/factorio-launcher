{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.invalid/schema/factorio/factorio_make_ready_joined_plan.v3.schema.json",
  "title": "Reviewed executable repair followed by existing joined preparation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "instance_id",
    "launch_intent",
    "desired_state",
    "inputs_sha256",
    "plan_sha256",
    "installation_plan",
    "repair_review_id",
    "archive_source_identity",
    "installation_root",
    "installation_executable"
  ],
  "properties": {
    "schema": {
      "const": "factorio.make_ready_joined_plan.v3"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "launch_intent": {
      "enum": [
        "menu",
        "load_save"
      ]
    },
    "desired_state": {
      "$ref": "factorio_make_ready_joined_plan.v1.schema.json#/properties/desired_state"
    },
    "inputs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installation_plan": {
      "$ref": "https://julesc013.github.io/factorio-launcher/contracts/schema/factorio/factorio_managed_repair_plan.v1.schema.json"
    },
    "repair_review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "archive_source_identity": {
      "type": "string",
      "pattern": "^file:.+:sha256:[0-9a-f]{64}$"
    },
    "installation_root": {
      "type": "string",
      "minLength": 1
    },
    "installation_executable": {
      "type": "string",
      "minLength": 1
    }
  }
}
