{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/factorio-launcher/contracts/schema/factorio/usk_uninstall_report.v1.schema.json",
  "title": "Universal Setup managed uninstall report",
  "type": "object",
  "required": [
    "schema",
    "report_id",
    "report_digest",
    "transaction_id",
    "plan_id",
    "install_id",
    "ownership_manifest_digest",
    "deleted_owned_files",
    "retained_changed_owned_files",
    "retained_unknown_paths",
    "retained_directories",
    "source_archive_deleted",
    "status",
    "completed_at"
  ],
  "properties": {
    "schema": { "const": "usk.uninstall_report.v1" },
    "report_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "report_digest": { "$ref": "#/$defs/sha256" },
    "transaction_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "install_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "ownership_manifest_digest": { "$ref": "#/$defs/sha256" },
    "deleted_owned_files": { "$ref": "#/$defs/relative_paths" },
    "retained_changed_owned_files": { "$ref": "#/$defs/relative_paths" },
    "retained_unknown_paths": { "$ref": "#/$defs/relative_paths" },
    "retained_directories": { "$ref": "#/$defs/relative_paths" },
    "source_archive_deleted": { "const": false },
    "status": { "enum": ["completed", "retained_foreign_content"] },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "retained_changed_owned_files": { "maxItems": 0 },
          "retained_unknown_paths": { "maxItems": 0 },
          "retained_directories": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "retained_foreign_content" } }, "required": ["status"] },
      "then": {
        "anyOf": [
          { "properties": { "retained_changed_owned_files": { "minItems": 1 } } },
          { "properties": { "retained_unknown_paths": { "minItems": 1 } } },
          { "properties": { "retained_directories": { "minItems": 1 } } }
        ]
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))(?!.*//)[^/:\\\\\\u0000]+(?:/[^/:\\\\\\u0000]+)*$"
    },
    "relative_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relative_path" }
    }
  },
  "additionalProperties": false
}
