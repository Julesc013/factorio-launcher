{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/factorio-launcher/contracts/schema/factorio/factorio_managed_repair_apply_result.v1.schema.json",
  "title": "FacMan Managed Repair Apply Result",
  "type": "object",
  "required": ["schema", "status", "disposition", "install_id", "plan_id", "plan_digest",
    "provider_plan_digest", "transaction_id", "completed_at", "installed_state_digest",
    "setup_state_ref", "last_verification_identity", "state_revision", "verification_status"],
  "properties": {
    "schema": { "const": "factorio.managed_repair_apply_result.v1" },
    "status": { "const": "completed" },
    "disposition": { "enum": ["applied", "projection_recovered", "already_completed"] },
    "install_id": { "$ref": "#/$defs/id" },
    "plan_id": { "$ref": "#/$defs/id" },
    "plan_digest": { "$ref": "#/$defs/sha256" },
    "provider_plan_digest": { "$ref": "#/$defs/sha256" },
    "transaction_id": { "$ref": "#/$defs/id" },
    "completed_at": { "type": "string", "format": "date-time" },
    "installed_state_digest": { "$ref": "#/$defs/sha256" },
    "setup_state_ref": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "last_verification_identity": { "$ref": "#/$defs/sha256" },
    "state_revision": { "type": "string", "minLength": 66, "maxLength": 385 },
    "verification_status": { "enum": ["pass", "warn"] }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
