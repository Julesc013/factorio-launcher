{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.invalid/schema/presentation/semantic_action_input.v1.schema.json",
  "title": "Descriptor-declared semantic action input contract",
  "type": "object",
  "required": ["schema", "fields"],
  "properties": {
    "schema": {"const": "facman.semantic_action_input.v1"},
    "fields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["field_id", "label", "type", "required", "default", "choices"],
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "label": {"type": "string", "minLength": 1, "maxLength": 128},
          "type": {
            "type": "string",
            "enum": ["string", "identifier", "integer", "boolean", "enum", "path"]
          },
          "required": {"type": "boolean"},
          "default": {"type": ["string", "null"]},
          "choices": {
            "type": "array",
            "maxItems": 1024,
            "items": {"type": "string", "maxLength": 4096}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
