{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.invalid/schema/presentation/presentation_action_receipt.v2.schema.json",
  "title": "FacMan durable presentation action receipt",
  "type": "object",
  "required": [
    "schema", "authority", "contract_version", "idempotency_key", "key_digest",
    "request_fingerprint", "action_id", "scope", "request_id", "operation_id",
    "attempt_id", "target_instance_id", "target_installation_id", "state",
    "result_length", "result_digest", "effect_set", "request_json", "result_json"
  ],
  "properties": {
    "schema": {"const": "facman.presentation_action_receipt.v2"},
    "authority": {"const": "facman.application.presentation_action.v1"},
    "contract_version": {"const": 2},
    "idempotency_key": {"type": "string", "minLength": 1},
    "key_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "target_instance_id": {"type": "string"},
    "target_installation_id": {"type": "string"},
    "state": {"enum": ["accepted_outcome_unknown", "terminal"]},
    "result_length": {"type": "integer", "minimum": 1, "maximum": 8388608},
    "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effect_set": {"type": "array", "items": {"type": "string"}},
    "request_json": {"type": "string", "minLength": 1, "maxLength": 8388608},
    "result_json": {"type": "string", "minLength": 1, "maxLength": 8388608}
  },
  "additionalProperties": false
}
