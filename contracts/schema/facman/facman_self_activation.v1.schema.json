{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/factorio-launcher/contracts/schema/facman/facman_self_activation.v1.schema.json",
  "title": "FacMan immutable self-maintenance activation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product_id", "operation", "operation_id", "source_generation_id", "target_generation_id", "previous"],
  "properties": {
    "schema": {"const": "facman.self_activation.v1"},
    "product_id": {"const": "facman"},
    "operation": {"enum": ["update", "downgrade", "rollback"]},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "source_generation_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_generation_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^$|^[A-Za-z0-9._-]{1,160}$"},
        "sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"previous": {"properties": {"name": {"const": ""}}}}},
      "then": {"properties": {"previous": {"properties": {"sha256": {"const": ""}}}}},
      "else": {"properties": {"previous": {"properties": {"sha256": {"pattern": "^[a-f0-9]{64}$"}}}}}
    }
  ]
}
