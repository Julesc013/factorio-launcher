{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/factorio-launcher/contracts/schema/facman/facman_self_maintenance_package.v1.schema.json",
  "title": "FacMan self-maintenance package descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product_id", "product_version", "generation_relative_path", "facman_source_revision", "universal_setup_revision", "setup_protocol", "package_layout", "entrypoints", "automatic_update"],
  "properties": {
    "schema": {"const": "facman.self_maintenance_package.v1"},
    "product_id": {"const": "facman"},
    "product_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$", "maxLength": 160},
    "generation_relative_path": {"type": "string", "pattern": "^generations/[0-9A-Za-z.+-]{1,160}$"},
    "facman_source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "universal_setup_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "setup_protocol": {"const": "facman.self_maintenance.v1"},
    "package_layout": {"const": "versioned_generation_with_maintenance_v1"},
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gui_relative_path", "cli_relative_path", "maintenance_relative_path"],
      "properties": {
        "gui_relative_path": {"const": "FacMan.exe"},
        "cli_relative_path": {"const": "bin/facman.exe"},
        "maintenance_relative_path": {"const": "maintenance/FacManSetup.exe"}
      }
    },
    "automatic_update": {"const": false}
  }
}
