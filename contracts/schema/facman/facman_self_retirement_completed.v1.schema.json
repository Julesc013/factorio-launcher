{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/factorio-launcher/contracts/schema/facman/facman_self_retirement_completed.v1.schema.json",
  "title": "FacMan immutable activation-chain retirement completion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "head_name", "head_sha256", "chain_digest", "completed_steps"],
  "properties": {
    "schema": {"const": "facman.self_retirement_completed.v1"},
    "head_name": {"type": "string", "pattern": "^activation\\.[A-Za-z0-9._-]{1,160}\\.v1\\.json$"},
    "head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chain_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "completed_steps": {"type": "string", "pattern": "^[1-9][0-9]{0,2}$"}
  }
}
