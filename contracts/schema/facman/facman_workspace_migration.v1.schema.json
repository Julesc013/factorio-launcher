{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/factorio-launcher/contracts/schema/facman/facman_workspace_migration.v1.schema.json",
  "title": "FacMan Workspace Migration",
  "type": "object",
  "required": ["schema", "command", "status", "apply_enabled", "actions"],
  "properties": {
    "schema": { "const": "facman.workspace_migration.v1" },
    "command": { "enum": ["workspace.migration.inspect", "workspace.migration.plan", "workspace.migration.apply"] },
    "status": { "enum": ["no_changes", "changes_detected"] },
    "apply_enabled": {
      "type": "boolean",
      "description": "True only when every pending action is supported and workspace ownership permits mutation."
    },
    "actions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["kind", "source", "target", "backup_required", "journal_required"],
        "properties": {
          "kind": { "enum": ["create_workspace_identity", "replace_literal_local_workspace_identity", "canonicalize_legacy_install_ref", "canonicalize_legacy_instance_manifest"] },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "backup_required": { "type": "boolean" },
          "journal_required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "no_changes" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "apply_enabled": { "const": true },
          "actions": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "changes_detected" } },
        "required": ["status"]
      },
      "then": { "properties": { "actions": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": { "apply_enabled": { "const": true } },
        "required": ["apply_enabled"]
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "properties": {
                "kind": {
                  "enum": [
                    "canonicalize_legacy_install_ref",
                    "canonicalize_legacy_instance_manifest"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
