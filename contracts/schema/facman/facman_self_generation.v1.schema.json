{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/factorio-launcher/contracts/schema/facman/facman_self_generation.v1.schema.json",
  "title": "FacMan retained self-maintenance generation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product_id", "generation_id", "product_version", "package_sha256", "facman_source_revision", "universal_setup_revision", "install_id", "install_root", "logical_root", "state_root", "acceptance_root", "gui", "maintenance_launcher"],
  "properties": {
    "schema": {"const": "facman.self_generation.v1"},
    "product_id": {"const": "facman"},
    "generation_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "product_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$", "maxLength": 160},
    "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "facman_source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "universal_setup_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "install_id": {
      "oneOf": [
        {"const": "facman.self"},
        {"type": "string", "pattern": "^facman\\.self\\.generation\\.[a-f0-9]{64}$"}
      ]
    },
    "install_root": {"type": "string", "minLength": 1, "maxLength": 8192},
    "logical_root": {"type": "string", "minLength": 1, "maxLength": 8192},
    "state_root": {"type": "string", "minLength": 1, "maxLength": 8192},
    "acceptance_root": {"type": "string", "minLength": 1, "maxLength": 8192},
    "gui": {"type": "string", "minLength": 1, "maxLength": 8192},
    "maintenance_launcher": {"type": "string", "minLength": 1, "maxLength": 8192}
  }
}
