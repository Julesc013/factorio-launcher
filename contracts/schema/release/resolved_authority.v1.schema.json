{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.resolved_authority.v1.schema.json",
  "title": "FacMan resolved artifact authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target_id", "product_id", "product_version", "resolution_digest", "artifacts", "product_authority_granted"],
  "properties": {
    "schema": { "const": "facman.resolved_authority.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "product_version": { "type": "string", "minLength": 1 },
    "resolution_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "product_authority_granted": { "const": false },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "ceiling", "capabilities"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "ceiling": { "type": "array", "items": { "type": "string" } },
          "capabilities": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
