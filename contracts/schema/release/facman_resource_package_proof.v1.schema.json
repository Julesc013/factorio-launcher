{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.example/schema/release/facman_resource_package_proof.v1.schema.json",
  "title": "Supplied-package resource qualification observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "profile_id",
    "package_mode",
    "platform",
    "source_revision",
    "source_tree",
    "source_dirty",
    "input_provenance",
    "input",
    "executable_sha256",
    "original_unchanged",
    "proof_source_artifact",
    "cases",
    "commands",
    "artifacts",
    "failure",
    "ownership",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "facman.resource_package_proof.v1"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "profile_id": {
      "enum": [
        "windows_product_x64",
        "linux_product_x64",
        "macos_product_x64"
      ]
    },
    "package_mode": {
      "enum": [
        "portable",
        "installed_stage"
      ]
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_dirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "input_provenance": {
      "const": "supplied_path_not_producer_attested"
    },
    "input": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "root",
        "executable",
        "resource",
        "manifest",
        "inventory_sha256",
        "inventory_artifact"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870912
            }
          }
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870912
            }
          }
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870912
            }
          }
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inventory_artifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      }
    },
    "executable_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_unchanged": {
      "type": "boolean"
    },
    "proof_source_artifact": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 32768
    },
    "cases": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "enum": [
              "original_identity",
              "relocated_identity",
              "export_members",
              "existing_output_refusal",
              "missing_resource_refusal",
              "truncated_resource_refusal",
              "foreign_resource_refusal",
              "no_display_terminal",
              "original_unchanged"
            ]
          },
          "status": {
            "const": "pass"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "exit_code",
          "timed_out",
          "output_limit_exceeded",
          "stdout",
          "stderr",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 32768
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "timed_out": {
            "type": "boolean"
          },
          "output_limit_exceeded": {
            "type": "boolean"
          },
          "stdout": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "stderr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 0,
            "maxLength": 4096
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33554432
          }
        }
      }
    },
    "failure": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 0,
      "maxLength": 4096
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "marker_sha256"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "marker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "tagging",
        "signing",
        "publication",
        "human_acceptance",
        "game",
        "live_installation"
      ],
      "properties": {
        "release": {
          "const": false
        },
        "tagging": {
          "const": false
        },
        "signing": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "human_acceptance": {
          "const": false
        },
        "game": {
          "const": false
        },
        "live_installation": {
          "const": false
        }
      }
    }
  }
}
