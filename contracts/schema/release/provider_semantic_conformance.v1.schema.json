{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/factorio-launcher/contracts/schema/release/provider_semantic_conformance.v1.schema.json",
  "title": "FacMan Provider Semantic Conformance Observation",
  "type": "object",
  "required": [
    "schema",
    "observed_at_utc",
    "result",
    "full_semantic_conformance",
    "facman",
    "platform",
    "providers",
    "provider_input_observation",
    "tracked_lock_records",
    "candidate_lock",
    "corpus",
    "normalization_policy",
    "modes",
    "semantic_classes",
    "normalized_semantic_sha256",
    "negative_controls",
    "required_skips",
    "tracked_lock_mutated",
    "provider_adoption",
    "provider_repin",
    "release_eligible",
    "authority"
  ],
  "properties": {
    "schema": {"const": "facman.provider_semantic_conformance_observation.v1"},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "result": {"const": "provider_semantic_conformance_pass"},
    "full_semantic_conformance": {"const": true},
    "facman": {"$ref": "#/$defs/sourceIdentity"},
    "platform": {
      "type": "object",
      "required": ["system", "architecture", "runner_os", "runner_arch"],
      "properties": {
        "system": {"enum": ["Windows", "Linux", "Darwin"]},
        "architecture": {"type": "string", "minLength": 1},
        "runner_os": {"type": "string", "minLength": 1},
        "runner_arch": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "object", "required": ["id", "commit", "tree"], "additionalProperties": true}
    },
    "provider_input_observation": {"$ref": "#/$defs/fileRecord"},
    "tracked_lock_records": {"type": "object", "required": ["workspace", "release_provider"], "additionalProperties": true},
    "candidate_lock": {"type": "object", "required": ["sha256", "conformance_only", "release_eligible"], "additionalProperties": true},
    "corpus": {
      "type": "object",
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"const": "facman-provider-semantic-corpus-01"},
        "path": {"const": "tests/fixtures/provider-semantic-conformance/corpus.v1.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "normalization_policy": {
      "type": "object",
      "required": ["schema", "sha256", "allowed_differences"],
      "properties": {
        "schema": {"const": "facman.provider_semantic_normalization_policy.v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "allowed_differences": {
          "type": "array",
          "items": {"enum": ["provider_mode", "provider_linkage", "probe_workspace", "build_location", "executable_location"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "modes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/mode"}
    },
    "semantic_classes": {
      "type": "object",
      "required": ["command_dispatch", "operation_outcomes", "structured_refusals", "interrupted_recovery", "release_resolution", "provider_contract_identity"],
      "properties": {
        "command_dispatch": {"const": "pass"},
        "operation_outcomes": {"const": "pass"},
        "structured_refusals": {"const": "pass"},
        "interrupted_recovery": {"const": "pass"},
        "release_resolution": {"const": "pass"},
        "provider_contract_identity": {"const": "pass"}
      },
      "additionalProperties": false
    },
    "normalized_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "negative_controls": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {"const": "refused"}
    },
    "required_skips": {"type": "array", "maxItems": 0},
    "tracked_lock_mutated": {"const": false},
    "provider_adoption": {"const": false},
    "provider_repin": {"const": false},
    "release_eligible": {"const": false},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceIdentity": {
      "type": "object",
      "required": ["commit", "tree"],
      "properties": {"commit": {"$ref": "#/$defs/sha1"}, "tree": {"$ref": "#/$defs/sha1"}},
      "additionalProperties": false
    },
    "fileRecord": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "sdkIdentity": {
      "type": "object",
      "required": ["id", "identity_sha256", "inventory_sha256", "abi_manifest_sha256", "contract_bundle_sha256"],
      "properties": {
        "id": {"enum": ["universal_launcher", "universal_setup"]},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "abi_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "contract_bundle_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "mode": {
      "type": "object",
      "required": ["name", "provider_mode", "linkage", "runtime_closure", "toolchain", "sdk_identities", "raw_result_sha256", "normalized_semantic_sha256", "result_record", "result"],
      "properties": {
        "name": {"enum": ["source_static", "source_shared", "installed_static", "installed_shared", "relocated_installed_static", "relocated_installed_shared", "private_runtime"]},
        "provider_mode": {"enum": ["source", "installed_static", "installed_shared"]},
        "linkage": {"enum": ["static", "shared"]},
        "runtime_closure": {"enum": ["build_tree", "installed_prefix", "relocated_prefix", "private_runtime"]},
        "toolchain": {"type": "object", "minProperties": 16, "additionalProperties": true},
        "sdk_identities": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/sdkIdentity"}},
        "raw_result_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "result_record": {"$ref": "#/$defs/fileRecord"},
        "result": {"const": "pass"}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["credentials", "factorio_execution", "observer_capture", "permit_issuance", "product_execution", "provider_adoption", "publication", "route_promotion", "setup_mutation", "signing"],
      "properties": {
        "credentials": {"const": false},
        "factorio_execution": {"const": false},
        "observer_capture": {"const": false},
        "permit_issuance": {"const": false},
        "product_execution": {"const": false},
        "provider_adoption": {"const": false},
        "publication": {"const": false},
        "route_promotion": {"const": false},
        "setup_mutation": {"const": false},
        "signing": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
