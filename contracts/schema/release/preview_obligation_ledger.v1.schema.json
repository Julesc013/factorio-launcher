{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.facman.dev/release/preview_obligation_ledger.v1.schema.json",
  "title": "FacMan Preview Obligation Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "qualification_plan", "authority", "source", "inputs", "configuration", "executed", "counts", "obligations"],
  "properties": {
    "schema": {"const": "facman.preview_obligation_ledger.v1"},
    "target": {"const": "windows_winforms_technical_preview_x64"},
    "qualification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "product_version", "environment", "resolution_digest", "qualified"],
      "properties": {
        "schema": {"const": "facman.resolved_qualification_plan.v1"},
        "product_version": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "resolution_digest": {"$ref": "#/$defs/sha256"},
        "qualified": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_authorized", "factorio_execution", "setup_mutation", "signing", "publication"],
      "properties": {
        "release_authorized": {"const": false},
        "factorio_execution": {"const": false},
        "setup_mutation": {"const": false},
        "signing": {"const": false},
        "publication": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "dirty", "provider_class"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"$ref": "#/$defs/revision"},
        "tree": {"$ref": "#/$defs/revision"},
        "dirty": {"type": "boolean"},
        "provider_class": {"enum": ["canonical", "repaired_provider_canary"]},
        "build_identity_sha256": {"$ref": "#/$defs/sha256"},
        "build_identity": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_root", "package_root", "artifact", "resolution"],
      "properties": {
        "build_root": {"$ref": "#/$defs/nullable_path"},
        "package_root": {"$ref": "#/$defs/nullable_path"},
        "artifact": {"$ref": "#/$defs/nullable_path"},
        "resolution": {"$ref": "#/$defs/nullable_path"}
      }
    },
    "configuration": {"type": "string", "minLength": 1},
    "executed": {"type": "boolean"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "blocked", "planned"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "planned": {"type": "integer", "minimum": 0}
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "classification", "commands", "requirements", "missing_inputs", "invalidation_paths", "command_results"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "blocked", "planned"]},
          "classification": {"type": "string", "minLength": 1},
          "commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
          "requirements": {"type": "array", "items": {"type": "string"}},
          "missing_inputs": {"type": "array", "items": {"type": "string"}},
          "invalidation_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "command_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "returncode", "duration_ms", "evidence", "evidence_sha256"],
              "properties": {
                "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "returncode": {"type": "integer"},
                "duration_ms": {"type": "number", "minimum": 0},
                "evidence": {"type": "string", "minLength": 1},
                "evidence_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_path": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    }
  }
}
