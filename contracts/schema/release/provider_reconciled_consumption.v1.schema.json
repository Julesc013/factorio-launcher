{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.invalid/contracts/release/provider_reconciled_consumption.v1.schema.json",
  "title": "FacMan reconciled provider consumption observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "observed_at_utc", "result", "facman", "platform", "providers",
    "sdk_consumption_observation", "tracked_lock_records", "modes",
    "normalized_semantic_sha256", "source_mode_rollback_proven",
    "installed_modes_source_independent", "provider_input_selection",
    "provider_input_adopted", "provider_repin", "release_source_coherent",
    "release_eligible", "resumed_work", "required_skips", "authority"
  ],
  "properties": {
    "schema": {"const": "facman.provider_reconciled_consumption_observation.v1"},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "result": {"enum": ["provider_reconciled_consumption_pass", "provider_reconciled_consumption_development_rehearsal"]},
    "facman": {"$ref": "#/$defs/sourceIdentity"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "architecture", "runner_os", "runner_arch"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "runner_os": {"type": "string", "minLength": 1},
        "runner_arch": {"type": "string", "minLength": 1}
      }
    },
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "commit", "tree", "remote", "canonical_main_ref"],
        "properties": {
          "id": {"enum": ["universal_launcher", "universal_setup"]},
          "commit": {"$ref": "#/$defs/sha1"},
          "tree": {"$ref": "#/$defs/sha1"},
          "remote": {"type": "string", "pattern": "^https://"},
          "canonical_main_ref": {"const": "refs/heads/main"}
        }
      }
    },
    "sdk_consumption_observation": {"$ref": "#/$defs/fileIdentity"},
    "tracked_lock_records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "release_provider"],
      "properties": {
        "workspace": {"$ref": "#/$defs/fileIdentity"},
        "release_provider": {"$ref": "#/$defs/fileIdentity"}
      }
    },
    "modes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "provider_mode", "linkage", "runtime_closure",
          "consumption_classification", "raw_probe_sha256",
          "normalized_semantic_sha256", "install", "result"
        ],
        "properties": {
          "name": {"enum": ["source_static", "source_shared", "installed_static", "installed_shared", "relocated_installed_static", "relocated_installed_shared", "private_runtime"]},
          "provider_mode": {"enum": ["source", "installed_static", "installed_shared"]},
          "linkage": {"enum": ["static", "shared"]},
          "runtime_closure": {"enum": ["build_tree", "installed_prefix", "relocated_prefix", "private_runtime"]},
          "consumption_classification": {"enum": ["tracked_source", "tracked_adopted_installed_static", "tracked_adopted_installed_shared"]},
          "raw_probe_sha256": {"$ref": "#/$defs/sha256"},
          "normalized_semantic_sha256": {"$ref": "#/$defs/sha256"},
          "install": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file_count", "sha256", "build_identity_sha256", "runtime_file_count", "runtime_sha256"],
            "properties": {
              "file_count": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"},
              "build_identity_sha256": {"$ref": "#/$defs/sha256"},
              "runtime_file_count": {"type": "integer", "minimum": 0},
              "runtime_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "result": {"const": "pass"}
        }
      }
    },
    "normalized_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "source_mode_rollback_proven": {"const": true},
    "installed_modes_source_independent": {"const": true},
    "provider_input_selection": {"const": "accepted_canonical_provider_set"},
    "provider_input_adopted": {"const": true},
    "provider_repin": {"const": true},
    "release_source_coherent": {"const": true},
    "release_eligible": {"const": false},
    "resumed_work": {"type": "boolean"},
    "required_skips": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"const": "provider_self_conformance"}
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "provider_reconciled_consumption_pass"}}},
      "then": {"properties": {"required_skips": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"result": {"const": "provider_reconciled_consumption_development_rehearsal"}}},
      "then": {"properties": {"required_skips": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"}
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factorio_execution", "observer_capture", "permit_issuance", "publication", "route_promotion", "setup_mutation", "signing"],
      "properties": {
        "factorio_execution": {"const": false},
        "observer_capture": {"const": false},
        "permit_issuance": {"const": false},
        "publication": {"const": false},
        "route_promotion": {"const": false},
        "setup_mutation": {"const": false},
        "signing": {"const": false}
      }
    }
  }
}
