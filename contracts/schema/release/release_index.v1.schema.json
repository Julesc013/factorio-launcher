{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.release_index.v1",
  "title": "FacMan Release Index",
  "type": "object",
  "required": [
    "schema",
    "profiles",
    "package_manifest",
    "support_matrix",
    "version_train",
    "autonomy_policy",
    "alpha_delegation",
    "alpha1_dev_integration_closeout",
    "alpha1_tag_truth_closeout",
    "alpha1_publication_preparation",
    "alpha5_promotion_candidate_closeout",
    "alpha5_final_candidate_closeout",
    "factorio_2_1_14_route_d3_d4_request",
    "capability_frontend_matrix",
    "technical_preview_scope",
    "foundation_public_beta_scope",
    "factorio_route_version_decision",
    "factorio_version_families",
    "technical_preview_incubator_debt"
  ],
  "properties": {
    "schema": { "const": "facman.release_index.v1" },
    "profiles": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "package_manifest": { "type": "string" },
    "support_matrix": { "type": "string" },
    "product_manifest": { "type": "string" },
    "build_manifest": { "type": "string" },
    "dependency_lock": { "type": "string" },
    "install_modes": { "type": "string" },
    "update_report": { "type": "string" },
    "offline_bundle": { "type": "string" },
    "artifact_matrix": { "type": "string" },
    "profile_catalog": { "type": "string" },
    "version_train": { "const": "release/index/version_train.v1.toml" },
    "autonomy_policy": { "const": "release/index/autonomy_policy.v1.toml" },
    "alpha_delegation": { "const": "release/index/alpha_delegation.v1.toml" },
    "alpha1_dev_integration_closeout": { "const": "release/index/alpha1_dev_integration_closeout.v1.toml" },
    "alpha1_tag_truth_closeout": { "const": "release/index/alpha1_tag_truth_closeout.v1.toml" },
    "alpha1_publication_preparation": { "const": "release/index/alpha1_publication_preparation.v1.toml" },
    "alpha5_promotion_candidate_closeout": { "const": "release/index/alpha5_promotion_candidate_closeout.v1.toml" },
    "alpha5_final_candidate_closeout": { "const": "release/index/alpha5_final_candidate_closeout.v1.toml" },
    "factorio_2_1_14_route_d3_d4_request": { "const": "release/index/factorio_2_1_14_route_d3_d4_request.v1.toml" },
    "capability_frontend_matrix": { "const": "release/index/capability_frontend_matrix.v1.toml" },
    "technical_preview_scope": { "const": "release/index/technical_preview_scope.v1.toml" },
    "foundation_public_beta_scope": { "const": "release/index/foundation_public_beta_scope.v2.toml" },
    "factorio_route_version_decision": { "const": "release/index/factorio_route_version_decision.v1.toml" },
    "factorio_version_families": { "const": "release/index/factorio_version_families.v1.toml" },
    "technical_preview_incubator_debt": { "const": "release/index/technical_preview_incubator_debt.v1.toml" },
    "misnumbering_containment": { "const": "release/index/misnumbering_containment.v1.toml" },
    "milestones": false,
    "withdrawal_policy": false
  },
  "additionalProperties": true
}
