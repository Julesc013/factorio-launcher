{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.release_index.v1",
  "title": "FacMan Release Index",
  "type": "object",
  "required": [
    "schema",
    "profiles",
    "package_manifest",
    "support_matrix",
    "version_train",
    "autonomy_policy",
    "capability_frontend_matrix"
  ],
  "properties": {
    "schema": { "const": "facman.release_index.v1" },
    "profiles": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "package_manifest": { "type": "string" },
    "support_matrix": { "type": "string" },
    "product_manifest": { "type": "string" },
    "build_manifest": { "type": "string" },
    "dependency_lock": { "type": "string" },
    "install_modes": { "type": "string" },
    "update_report": { "type": "string" },
    "offline_bundle": { "type": "string" },
    "artifact_matrix": { "type": "string" },
    "profile_catalog": { "type": "string" },
    "version_train": { "const": "release/index/version_train.v1.toml" },
    "autonomy_policy": { "const": "release/index/autonomy_policy.v1.toml" },
    "capability_frontend_matrix": { "const": "release/index/capability_frontend_matrix.v1.toml" },
    "milestones": false,
    "withdrawal_policy": false
  },
  "additionalProperties": true
}
