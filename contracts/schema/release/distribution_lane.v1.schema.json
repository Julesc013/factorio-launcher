{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.distribution_lane.v1",
  "title": "FacMan Distribution Lane Catalog",
  "type": "object",
  "required": [
    "schema",
    "lane_collection_role",
    "active_release_view",
    "lane"
  ],
  "properties": {
    "schema": { "const": "facman.distribution_lane.v1" },
    "lane_collection_role": { "const": "distribution_catalog_selected_by_active_release_view" },
    "active_release_view": { "const": "release/index/active_release_view.v1.toml" },
    "lane": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "release_role",
          "current_release_obligation",
          "target_os",
          "target_arch",
          "frontend_family",
          "package_types",
          "install_modes",
          "support_tier",
          "setup_mutation",
          "network_download"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "release_role": {
            "enum": [
              "reference_product",
              "selected_preview_product",
              "historical_compatibility_evidence"
            ]
          },
          "current_release_obligation": { "type": "boolean" },
          "target_os": {
            "enum": ["windows", "macos", "linux", "portable", "source"]
          },
          "target_arch": { "type": "string", "minLength": 1 },
          "frontend_family": { "type": "string", "minLength": 1 },
          "package_types": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "install_modes": {
            "type": "array",
            "items": { "enum": ["portable", "user", "system"] },
            "minItems": 1
          },
          "support_tier": { "type": "string", "minLength": 1 },
          "setup_mutation": { "type": "boolean" },
          "network_download": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
