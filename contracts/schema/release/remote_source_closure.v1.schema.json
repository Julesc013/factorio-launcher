{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.remote_source_closure.v1",
  "title": "FacMan remote-only three-repository source closure",
  "type": "object",
  "required": [
    "schema",
    "status",
    "observed_at_utc",
    "claim",
    "authority_promotion",
    "factorio_execution",
    "permit_issuance",
    "publication",
    "clone_policy",
    "repositories",
    "workspace",
    "tooling",
    "validation",
    "package"
  ],
  "properties": {
    "schema": { "const": "facman.remote_source_closure.v1" },
    "status": { "const": "pass" },
    "observed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "claim": { "const": "remote_source_closure_proven" },
    "authority_promotion": { "const": false },
    "factorio_execution": { "const": false },
    "permit_issuance": { "const": false },
    "publication": { "const": false },
    "clone_policy": {
      "type": "object",
      "required": [
        "empty_directories",
        "git_clone_no_local",
        "git_core_longpaths",
        "https_remotes_only",
        "preexisting_objects",
        "alternates",
        "replace_refs",
        "shallow_repositories",
        "partial_clone_or_promisor",
        "config_includes",
        "unexpected_object_directories",
        "hostile_inherited_git_environment",
        "system_and_global_config_disabled",
        "detached_exact_checkouts"
      ],
      "properties": {
        "empty_directories": { "const": true },
        "git_clone_no_local": { "const": true },
        "git_core_longpaths": { "const": true },
        "https_remotes_only": { "const": true },
        "preexisting_objects": { "const": false },
        "alternates": { "const": false },
        "replace_refs": { "const": false },
        "shallow_repositories": { "const": false },
        "partial_clone_or_promisor": { "const": false },
        "config_includes": { "const": false },
        "unexpected_object_directories": { "const": false },
        "hostile_inherited_git_environment": { "const": false },
        "system_and_global_config_disabled": { "const": true },
        "detached_exact_checkouts": { "const": true }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/repository" }
    },
    "workspace": {
      "type": "object",
      "required": [
        "clone_root",
        "build_root",
        "paths_are_local_observations",
        "source_worktrees_clean_after_validation"
      ],
      "properties": {
        "clone_root": { "type": "string", "minLength": 1 },
        "build_root": { "type": "string", "minLength": 1 },
        "paths_are_local_observations": { "const": true },
        "source_worktrees_clean_after_validation": { "const": true }
      },
      "additionalProperties": false
    },
    "tooling": {
      "type": "object",
      "required": ["git", "cmake", "python", "host"],
      "properties": {
        "git": { "type": "string", "minLength": 1 },
        "cmake": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["steps", "test_counts", "strict_repositories", "aide_lite"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 18,
          "items": { "$ref": "#/$defs/step" }
        },
        "test_counts": {
          "type": "object",
          "required": [
            "factorio-launcher_native",
            "factorio-launcher_python",
            "universal-launcher_native",
            "universal-setup_native"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "strict_repositories": {
          "type": "array",
          "const": [
            "factorio-launcher",
            "universal-launcher",
            "universal-setup"
          ]
        },
        "aide_lite": { "const": "pass" }
      },
      "additionalProperties": false
    },
    "package": { "$ref": "#/$defs/package" },
    "successor": { "$ref": "#/$defs/successor" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "type": "object",
      "required": [
        "id",
        "remote",
        "required_ref",
        "pin",
        "head",
        "tree",
        "detached",
        "clean",
        "alternates",
        "replace_refs",
        "shallow",
        "partial_clone",
        "promisor",
        "config_includes",
        "unexpected_object_directories",
        "hostile_git_environment",
        "object_format",
        "local_clone",
        "canonical_ref_contains_pin",
        "remote_ref_head",
        "pin_equals_remote_ref_head",
        "line_endings"
      ],
      "properties": {
        "id": {
          "enum": [
            "factorio-launcher",
            "universal-launcher",
            "universal-setup"
          ]
        },
        "remote": {
          "type": "string",
          "pattern": "^https://"
        },
        "required_ref": {
          "type": "string",
          "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"
        },
        "pin": { "$ref": "#/$defs/gitSha" },
        "head": { "$ref": "#/$defs/gitSha" },
        "tree": { "$ref": "#/$defs/gitSha" },
        "detached": { "const": true },
        "clean": { "const": true },
        "alternates": { "const": false },
        "replace_refs": { "const": false },
        "shallow": { "const": false },
        "partial_clone": { "const": false },
        "promisor": { "const": false },
        "config_includes": { "const": false },
        "unexpected_object_directories": { "const": false },
        "hostile_git_environment": { "const": false },
        "object_format": { "const": "sha1" },
        "local_clone": { "const": false },
        "canonical_ref_contains_pin": { "const": true },
        "remote_ref_head": { "$ref": "#/$defs/gitSha" },
        "pin_equals_remote_ref_head": { "type": "boolean" },
        "line_endings": {
          "type": "object",
          "required": [
            "attributes_path",
            "attributes_sha256",
            "tracked_eol_inventory_sha256",
            "core_autocrlf"
          ],
          "properties": {
            "attributes_path": { "const": ".gitattributes" },
            "attributes_sha256": { "$ref": "#/$defs/sha256" },
            "tracked_eol_inventory_sha256": { "$ref": "#/$defs/sha256" },
            "core_autocrlf": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["label", "status", "command"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "status": { "const": "pass" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": [
        "profile_id",
        "package_file_count",
        "artifact",
        "artifact_size",
        "artifact_sha256",
        "provenance",
        "provenance_sha256",
        "manifest",
        "manifest_sha256",
        "build_info_sha256",
        "stage_manifest",
        "stage_manifest_sha256",
        "stage_digest",
        "resolution_root_digest",
        "source_observation_digest",
        "runtime_metadata_sha256",
        "runtime_metadata_digest",
        "runtime_smoke",
        "archive_runtime_smoke",
        "provenance_verification",
        "installed_sdk_proof",
        "required_package_tests",
        "required_package_skips",
        "source_revisions",
        "toolchain",
        "signed",
        "published"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "package_file_count": { "type": "integer", "minimum": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "artifact_size": { "type": "integer", "minimum": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "provenance": { "type": "string", "minLength": 1 },
        "provenance_sha256": { "$ref": "#/$defs/sha256" },
        "manifest": { "const": "manifest/package.v1.toml" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "build_info_sha256": { "$ref": "#/$defs/sha256" },
        "stage_manifest": { "const": "manifest/stage.v1.json" },
        "stage_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "stage_digest": { "$ref": "#/$defs/sha256" },
        "resolution_root_digest": { "$ref": "#/$defs/sha256" },
        "source_observation_digest": { "$ref": "#/$defs/sha256" },
        "runtime_metadata_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_metadata_digest": { "$ref": "#/$defs/sha256" },
        "runtime_smoke": { "const": "pass" },
        "archive_runtime_smoke": { "const": "pass" },
        "provenance_verification": { "const": "pass" },
        "installed_sdk_proof": { "const": true },
        "required_package_tests": { "type": "integer", "minimum": 1 },
        "required_package_skips": { "const": 0 },
        "source_revisions": {
          "type": "object",
          "required": [
            "factorio_launcher",
            "universal_launcher",
            "universal_setup"
          ],
          "properties": {
            "factorio_launcher": { "$ref": "#/$defs/gitSha" },
            "universal_launcher": { "$ref": "#/$defs/gitSha" },
            "universal_setup": { "$ref": "#/$defs/gitSha" }
          },
          "additionalProperties": false
        },
        "toolchain": { "type": "object", "minProperties": 1 },
        "signed": { "const": false },
        "published": { "const": false }
      },
      "additionalProperties": false
    },
    "successor": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "closure_scope",
        "canonical_gate_satisfied",
        "source_closure_id",
        "route",
        "candidate",
        "factorio",
        "instance",
        "workspace_root_authority",
        "test_contracts",
        "test_contracts_digest",
        "authority",
        "source_closure_digest"
      ],
      "properties": {
        "schema": { "const": "facman.successor_play_source_closure.v1" },
        "status": {
          "enum": [
            "task_ref_reconstruction_passed",
            "canonical_source_closure_passed"
          ]
        },
        "closure_scope": { "enum": ["task_ref_rehearsal", "canonical_ref"] },
        "canonical_gate_satisfied": { "type": "boolean" },
        "source_closure_id": { "const": "facman.successor-play.source-closure.01" },
        "route": {
          "type": "object",
          "required": [
            "route_id",
            "definition_digest",
            "definition_file_sha256",
            "immutable"
          ],
          "properties": {
            "route_id": { "type": "string", "minLength": 1 },
            "definition_digest": { "$ref": "#/$defs/sha256" },
            "definition_file_sha256": { "$ref": "#/$defs/sha256" },
            "immutable": { "const": true }
          },
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "required": [
            "package",
            "package_sha256",
            "manifest_sha256",
            "stage_manifest_sha256",
            "resolution_root_digest",
            "source_observation_digest"
          ],
          "properties": {
            "package": { "type": "string", "minLength": 1 },
            "package_sha256": { "$ref": "#/$defs/sha256" },
            "manifest_sha256": { "$ref": "#/$defs/sha256" },
            "stage_manifest_sha256": { "$ref": "#/$defs/sha256" },
            "resolution_root_digest": { "$ref": "#/$defs/sha256" },
            "source_observation_digest": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "factorio": {
          "type": "object",
          "required": [
            "archive",
            "archive_size",
            "archive_sha256",
            "executable_member",
            "executable_size",
            "executable_sha256",
            "version",
            "distribution",
            "read_only_observation",
            "executed"
          ],
          "properties": {
            "archive": { "type": "string", "minLength": 1 },
            "archive_size": { "type": "integer", "minimum": 1 },
            "archive_sha256": { "$ref": "#/$defs/sha256" },
            "executable_member": { "type": "string", "minLength": 1 },
            "executable_size": { "type": "integer", "minimum": 1 },
            "executable_sha256": { "$ref": "#/$defs/sha256" },
            "version": { "type": "string", "minLength": 1 },
            "distribution": { "type": "string", "minLength": 1 },
            "read_only_observation": { "const": true },
            "executed": { "const": false }
          },
          "additionalProperties": false
        },
        "instance": {
          "type": "object",
          "required": [
            "spec",
            "spec_digest",
            "binding",
            "binding_digest",
            "readiness",
            "readiness_digest"
          ],
          "properties": {
            "spec": { "type": "object", "minProperties": 1 },
            "spec_digest": { "$ref": "#/$defs/sha256" },
            "binding": { "type": "object", "minProperties": 1 },
            "binding_digest": { "$ref": "#/$defs/sha256" },
            "readiness": { "type": "object", "minProperties": 1 },
            "readiness_digest": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "workspace_root_authority": { "type": "object", "minProperties": 1 },
        "test_contracts": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "test_contracts_digest": { "$ref": "#/$defs/sha256" },
        "authority": {
          "type": "object",
          "required": [
            "provider_repin",
            "factorio_execution",
            "observer_capture",
            "stage_authority",
            "prepare",
            "permit_issuance",
            "setup_mutation",
            "credential_access",
            "signing",
            "publication",
            "route_capability",
            "route_promotion"
          ],
          "additionalProperties": { "const": false }
        },
        "source_closure_digest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
