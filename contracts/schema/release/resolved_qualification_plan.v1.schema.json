{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.resolved_qualification_plan.v1.schema.json",
  "title": "FacMan resolved qualification plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target_id", "product_id", "product_version", "resolution_digest", "environment", "obligations", "evidence", "qualified"],
  "properties": {
    "schema": { "const": "facman.resolved_qualification_plan.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "product_version": { "type": "string", "minLength": 1 },
    "resolution_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment": { "type": "string", "minLength": 1 },
    "obligations": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "qualified": { "type": "boolean" }
  }
}
