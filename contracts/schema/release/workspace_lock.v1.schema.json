{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flaunch.workspace_lock.v1",
  "title": "FacMan Workspace Lock",
  "type": "object",
  "required": ["schema", "id", "lock_kind", "lock_root", "component"],
  "properties": {
    "schema": { "const": "flaunch.workspace_lock.v1" },
    "id": { "type": "string" },
    "lock_kind": { "type": "string" },
    "lock_root": { "type": "string" },
    "component": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "source", "pin", "path"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "pin": { "type": "string" },
          "path": { "type": "string" },
          "remote": { "type": "string", "format": "uri" },
          "required_ref": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$" },
          "reachability": { "const": "required_for_source_closure" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "id": { "enum": ["universal_launcher", "universal_setup"] }
              },
              "required": ["id"]
            },
            "then": {
              "required": ["remote", "required_ref", "reachability"]
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
