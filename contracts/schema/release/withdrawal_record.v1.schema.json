{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.withdrawal_record.v1",
  "title": "FacMan release withdrawal record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "version",
    "tag",
    "release_class",
    "prior_state",
    "new_state",
    "reason",
    "replacement_version",
    "artifact_digests",
    "issued_at",
    "issued_by_role",
    "human_decision_id",
    "notifications",
    "immutable_tag_verified",
    "assets_retained",
    "authority"
  ],
  "properties": {
    "schema": { "const": "facman.withdrawal_record.v1" },
    "record_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "release_class": { "enum": ["alpha", "beta", "rc", "stable_0x", "stable_1x"] },
    "prior_state": { "enum": ["active", "superseded"] },
    "new_state": { "enum": ["superseded", "withdrawn", "revoked"] },
    "reason": { "type": "string", "minLength": 1 },
    "replacement_version": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/semver" }]
    },
    "artifact_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "issued_by_role": { "enum": ["automation_control", "human_owner"] },
    "human_decision_id": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    },
    "notifications": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "immutable_tag_verified": { "const": true },
    "assets_retained": { "const": true },
    "authority": { "$ref": "#/$defs/authority" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "new_state": { "const": "superseded" } },
        "required": ["new_state"]
      },
      "then": { "properties": { "replacement_version": { "$ref": "#/$defs/semver" } } }
    },
    {
      "if": {
        "properties": {
          "release_class": { "enum": ["beta", "rc", "stable_0x", "stable_1x"] }
        },
        "required": ["release_class"]
      },
      "then": {
        "properties": {
          "issued_by_role": { "const": "human_owner" },
          "human_decision_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_mutation", "asset_mutation", "publication", "production_notification"],
      "properties": {
        "tag_mutation": { "const": false },
        "asset_mutation": { "const": false },
        "publication": { "const": false },
        "production_notification": { "const": false }
      }
    }
  }
}
