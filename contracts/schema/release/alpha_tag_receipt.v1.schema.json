{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.alpha_tag_receipt.v1",
  "title": "FacMan immutable unpublished alpha tag receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tag",
    "tag_object_sha",
    "tag_ruleset_ids",
    "source_revision",
    "source_tree",
    "candidate_sha256",
    "eligibility_sha256",
    "github_run_id",
    "created_at",
    "publication",
    "signing"
  ],
  "properties": {
    "schema": { "const": "facman.alpha_tag_receipt.v1" },
    "tag": { "type": "string", "pattern": "^v0\\.1\\.0-alpha\\.([1-9][0-9]*)$" },
    "tag_object_sha": { "$ref": "#/$defs/revision" },
    "tag_ruleset_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "source_revision": { "$ref": "#/$defs/revision" },
    "source_tree": { "$ref": "#/$defs/revision" },
    "candidate_sha256": { "$ref": "#/$defs/sha256" },
    "eligibility_sha256": { "$ref": "#/$defs/sha256" },
    "github_run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "publication": { "const": false },
    "signing": { "const": false }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
