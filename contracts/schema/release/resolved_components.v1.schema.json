{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.resolved_components.v1.schema.json",
  "title": "FacMan resolved components",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target_id", "product_id", "product_version", "resolution_digest", "components"],
  "properties": {
    "schema": { "const": "facman.resolved_components.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "product_version": { "type": "string", "minLength": 1 },
    "resolution_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "identity", "kind", "owner", "provider", "dependencies", "build_options", "authority_capabilities"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "kind": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "provider": { "type": ["string", "null"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "build_options": { "type": "object" },
          "authority_capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
