{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.alpha_release_source.v1",
  "title": "FacMan tagless alpha release-source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "work_unit",
    "version",
    "canonical_version",
    "channel",
    "release_class",
    "source",
    "tag",
    "package",
    "assets",
    "qualification",
    "support",
    "known_limitations",
    "packet_binding",
    "authority"
  ],
  "properties": {
    "schema": { "const": "facman.alpha_release_source.v1" },
    "work_unit": { "const": "FACMAN-0.1.0-ALPHA.1-RELEASE-SOURCE-01" },
    "version": { "const": "0.1.0-alpha.1" },
    "canonical_version": { "const": "facman-0.1.0-alpha.1" },
    "channel": { "const": "alpha" },
    "release_class": { "const": "alpha" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_revision", "base_tree", "accepted_ref", "candidate_binding"],
      "properties": {
        "base_revision": { "$ref": "#/$defs/revision" },
        "base_tree": { "$ref": "#/$defs/revision" },
        "accepted_ref": { "const": "dev" },
        "candidate_binding": { "const": "exact_accepted_dev_head_after_merge" }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "annotated", "status"],
      "properties": {
        "name": { "const": "v0.1.0-alpha.1" },
        "annotated": { "const": true },
        "status": { "const": "uncreated_pending_separate_authority" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "artifact_id", "filename", "format"],
      "properties": {
        "target_id": { "const": "windows_winforms_technical_preview_x64" },
        "artifact_id": { "const": "windows_winforms_technical_preview_zip" },
        "filename": { "const": "facman-0.1.0-alpha.1-windows-winforms-x86_64-technical-preview.zip" },
        "format": { "const": "zip" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "filename", "required"],
        "properties": {
          "role": {
            "enum": [
              "package",
              "checksums",
              "sbom",
              "provenance",
              "known_limitations",
              "licence_inventory",
              "candidate_record",
              "route_receipt",
              "release_ledger_entry",
              "publication_authority_receipt"
            ]
          },
          "filename": { "type": "string", "minLength": 1 },
          "required": { "const": true }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["three_root_reproducibility", "native_verification", "drift_refusal", "real_play_route", "human_receipt"],
      "properties": {
        "three_root_reproducibility": { "const": "required_before_tag" },
        "native_verification": { "const": "required_in_every_root" },
        "drift_refusal": { "const": "required_in_every_root" },
        "real_play_route": { "const": "required_before_publication" },
        "human_receipt": { "const": "not_required_for_alpha_required_for_beta" }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "published_support", "unsigned_allowed_if_disclosed"],
      "properties": {
        "class": { "const": "unsupported_public_alpha" },
        "published_support": { "const": false },
        "unsigned_allowed_if_disclosed": { "const": true }
      }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "packet_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_packet", "human_template", "binding_mode"],
      "properties": {
        "route_packet": { "const": "release/index/factorio_2_1_14_route_packet.v1.toml" },
        "human_template": { "const": "docs/quality/evidence/facman_accessibility_human_test_receipt.template.v1.json" },
        "binding_mode": { "const": "derive_from_verified_package_and_resolution_after_source_freeze" }
      }
    },
    "authority": { "$ref": "#/$defs/authority" }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factorio_execution", "setup_mutation", "tag_creation", "signing", "publication", "support_promotion", "human_verdict"],
      "properties": {
        "factorio_execution": { "const": false },
        "setup_mutation": { "const": false },
        "tag_creation": { "const": false },
        "signing": { "const": false },
        "publication": { "const": false },
        "support_promotion": { "const": false },
        "human_verdict": { "const": false }
      }
    }
  }
}
