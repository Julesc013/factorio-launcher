{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facman.example/schema/release/provider_package_import.v1.schema.json",
  "title": "FacMan provider package import evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result",
    "provider_id",
    "source",
    "package_version",
    "abi_version",
    "state_formats",
    "profiles",
    "facman_release_context",
    "generated",
    "authorizing"
  ],
  "properties": {
    "schema": { "const": "facman.provider_package_import.v1" },
    "result": { "const": "accepted" },
    "provider_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "ref", "repository"],
      "properties": {
        "commit": { "$ref": "#/$defs/revision" },
        "tree": { "$ref": "#/$defs/revision" },
        "ref": { "const": "refs/heads/main" },
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "package_version": { "type": "string", "minLength": 1 },
    "abi_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "state_formats": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/stateFormat" }
    },
    "profiles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "linkage", "manifest_sha256"],
        "properties": {
          "system": { "enum": ["linux", "macos", "windows"] },
          "linkage": { "enum": ["static", "shared"] },
          "manifest_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "facman_release_context": { "$ref": "#/$defs/revision" },
    "generated": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "authorizing": { "const": false }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stateFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_versions", "write_version"],
      "properties": {
        "read_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "write_version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
