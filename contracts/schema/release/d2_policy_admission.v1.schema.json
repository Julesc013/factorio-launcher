{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d2_policy_admission.v1.schema.json",
  "title": "FacMan D2 policy admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "admission_id", "repository", "workunit", "subject", "implementation_attestation_sha256", "assurance_attestation_sha256", "policy_identity", "exact_head_immutable", "history_preserving_merge", "merge_method", "checks", "unresolved_review_threads", "post_merge_verification_required", "d4_excluded", "owner_ratification", "decision", "created_at", "authority"],
  "properties": {
    "schema": {"const": "facman.d2_policy_admission.v1"},
    "admission_id": {"$ref": "#/$defs/id"},
    "repository": {"const": "Julesc013/factorio-launcher"},
    "workunit": {"$ref": "#/$defs/id"},
    "subject": {"$ref": "#/$defs/subject"},
    "implementation_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "assurance_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "policy_identity": {"$ref": "#/$defs/identity"},
    "exact_head_immutable": {"const": true},
    "history_preserving_merge": {"const": true},
    "merge_method": {"const": "merge"},
    "checks": {"$ref": "#/$defs/checks"},
    "unresolved_review_threads": {"const": 0},
    "post_merge_verification_required": {"const": true},
    "d4_excluded": {"const": true},
    "owner_ratification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "record_sha256"],
      "properties": {
        "required": {"const": true},
        "status": {"const": "pending"},
        "record_sha256": {"type": "null"}
      }
    },
    "decision": {"const": "ready_for_owner_ratification"},
    "created_at": {"type": "string", "format": "date-time"},
    "authority": {"$ref": "#/$defs/no_d4_authority"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,159}$"},
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@/-]{0,159}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_revision", "base_tree", "head_revision", "head_tree", "changed_paths_sha256"],
      "properties": {
        "base_revision": {"$ref": "#/$defs/revision"},
        "base_tree": {"$ref": "#/$defs/revision"},
        "head_revision": {"$ref": "#/$defs/revision"},
        "head_tree": {"$ref": "#/$defs/revision"},
        "changed_paths_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "head_revision"],
        "properties": {
          "name": {"$ref": "#/$defs/id"},
          "state": {"const": "success"},
          "head_revision": {"$ref": "#/$defs/revision"}
        }
      }
    },
    "no_d4_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_credentials", "production_signing", "publication", "route_promotion", "human_verdict", "stable_promotion", "protected_branch_write", "self_merge"],
      "properties": {
        "production_credentials": {"const": false},
        "production_signing": {"const": false},
        "publication": {"const": false},
        "route_promotion": {"const": false},
        "human_verdict": {"const": false},
        "stable_promotion": {"const": false},
        "protected_branch_write": {"const": false},
        "self_merge": {"const": false}
      }
    }
  }
}
