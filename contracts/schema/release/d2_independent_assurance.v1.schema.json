{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d2_independent_assurance.v1.schema.json",
  "title": "FacMan D2 independent assurance attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "attestation_id", "repository", "workunit", "subject", "implementation_attestation_sha256", "assurance_identity", "logically_independent", "checks", "findings", "unresolved_findings", "high_risk_review_complete", "conclusion", "created_at", "authority"],
  "properties": {
    "schema": {"const": "facman.d2_independent_assurance.v1"},
    "attestation_id": {"$ref": "#/$defs/id"},
    "repository": {"const": "Julesc013/factorio-launcher"},
    "workunit": {"$ref": "#/$defs/id"},
    "subject": {"$ref": "#/$defs/subject"},
    "implementation_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "assurance_identity": {"$ref": "#/$defs/identity"},
    "logically_independent": {"const": true},
    "checks": {"$ref": "#/$defs/checks"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
          "status": {"enum": ["resolved", "accepted_by_owner"]}
        }
      }
    },
    "unresolved_findings": {"const": 0},
    "high_risk_review_complete": {"type": "boolean"},
    "conclusion": {"const": "pass"},
    "created_at": {"type": "string", "format": "date-time"},
    "authority": {"$ref": "#/$defs/no_d4_authority"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,159}$"},
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@/-]{0,159}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_revision", "base_tree", "head_revision", "head_tree", "changed_paths_sha256"],
      "properties": {
        "base_revision": {"$ref": "#/$defs/revision"},
        "base_tree": {"$ref": "#/$defs/revision"},
        "head_revision": {"$ref": "#/$defs/revision"},
        "head_tree": {"$ref": "#/$defs/revision"},
        "changed_paths_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "head_revision"],
        "properties": {
          "name": {"$ref": "#/$defs/id"},
          "state": {"const": "success"},
          "head_revision": {"$ref": "#/$defs/revision"}
        }
      }
    },
    "no_d4_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_credentials", "production_signing", "publication", "route_promotion", "human_verdict", "stable_promotion", "protected_branch_write", "self_merge"],
      "properties": {
        "production_credentials": {"const": false},
        "production_signing": {"const": false},
        "publication": {"const": false},
        "route_promotion": {"const": false},
        "human_verdict": {"const": false},
        "stable_promotion": {"const": false},
        "protected_branch_write": {"const": false},
        "self_merge": {"const": false}
      }
    }
  }
}
