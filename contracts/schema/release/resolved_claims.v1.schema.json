{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facman.resolved_claims.v1.schema.json",
  "title": "FacMan resolved support claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target_id", "product_id", "product_version", "resolution_digest", "claims"],
  "properties": {
    "schema": { "const": "facman.resolved_claims.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "product_version": { "type": "string", "minLength": 1 },
    "resolution_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "support_class", "required_evidence", "established", "target_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "support_class": { "type": "string", "minLength": 1 },
          "required_evidence": { "type": "array", "items": { "type": "string" } },
          "established": { "type": "boolean" },
          "target_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
