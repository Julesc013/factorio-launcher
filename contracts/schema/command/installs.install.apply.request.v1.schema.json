{
  "$id": "https://facman.invalid/schema/command/installs.install.apply.request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applied_at": {
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "archive": {
      "minLength": 1,
      "type": "string"
    },
    "confirmation": {
      "enum": [
        "APPLY"
      ],
      "minLength": 1,
      "type": "string"
    },
    "install_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "plan_created_at": {
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "plan_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "target_root": {
      "minLength": 1,
      "type": "string"
    },
    "transaction_id": {
      "maxLength": 64,
      "minLength": 4,
      "pattern": "^tx-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "version",
    "archive",
    "target_root",
    "install_id",
    "plan_id",
    "plan_digest",
    "plan_created_at",
    "transaction_id",
    "applied_at",
    "confirmation"
  ],
  "title": "installs.install.apply request",
  "type": "object"
}
