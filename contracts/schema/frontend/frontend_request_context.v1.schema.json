{
  "$id": "https://facman.invalid/schema/frontend/frontend_request_context.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "type": "string"},
    "deadline_ms": {"maximum": 3600000, "minimum": 1, "type": "integer"},
    "dry_run": {"type": "boolean"},
    "explain": {"type": "boolean"},
    "operation_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "type": "string"},
    "request_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "type": "string"}
  },
  "required": ["request_id", "operation_id", "attempt_id", "deadline_ms", "dry_run", "explain"],
  "title": "FacMan typed frontend request context",
  "type": "object"
}
